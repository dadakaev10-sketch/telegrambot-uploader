# Telegram-Bot – auf jedem Laptop einen eigenen BOT_TOKEN verwenden.
BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# Nur diese Telegram-Chats dürfen den Bot bedienen (mehrere mit Komma trennen).
# Die eigene ID erhältst du z. B. über @userinfobot.
ALLOWED_CHAT_IDS=REPLACE_WITH_YOUR_CHAT_ID

# Telethon von https://my.telegram.org
API_ID=REPLACE_WITH_API_ID
API_HASH=REPLACE_WITH_API_HASH
TELETHON_SESSION=uploader_laptop_2

# Zielkanal, z. B. @kanalname oder -100xxxxxxxxxx
CHANNEL_ID=REPLACE_WITH_CHANNEL_ID

# Gemeinsamer PostgreSQL-Medienbestand
POSTGRES_HOST=REPLACE_WITH_VPS_HOST
POSTGRES_PORT=15432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_PASSWORD
POSTGRES_SSLMODE=prefer
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_VPS_HOST:15432/postgres?sslmode=prefer

# Queue-Betrieb:
#   producer = Telegram-Bot nimmt Links an und legt sie in PostgreSQL ab
#   worker   = dieser Rechner reserviert und verarbeitet PostgreSQL-Jobs
#   local    = bisheriges Verhalten mit bot/queue.json
CENTRAL_QUEUE_ROLE=local
CENTRAL_QUEUE_POLL_SECONDS=5
CENTRAL_QUEUE_LEASE_SECONDS=7200
CENTRAL_QUEUE_HEARTBEAT_SECONDS=60
# false = Remote-Downloads erst per Telegram-Button starten
CENTRAL_QUEUE_AUTOSTART=false
# Auf jedem Worker eindeutig setzen, z. B. remote-macbook-1
CENTRAL_QUEUE_WORKER_ID=

# Bei unterschiedlichen Telegram-Bots darf dies auf beiden Macs true sein.
RUN_TELEGRAM_POLLING=true
